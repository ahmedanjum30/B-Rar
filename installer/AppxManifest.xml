<?xml version="1.0" encoding="utf-8"?>
<!-- MSIX manifest for B-Rar. installer\build.ps1 fills in {{VERSION}}.
     The Publisher must match the signing certificate's subject exactly. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop desktop4 desktop5 com rescap">

  <Identity Name="AhmadAnjum.B-Rar" Publisher="CN=Ahmad Anjum" Version="{{VERSION}}" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>B-Rar</DisplayName>
    <PublisherDisplayName>Ahmad Anjum</PublisherDisplayName>
    <Description>Fast, parallel archive extractor for zip, 7z, rar and tar.</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <!-- B-Rar-GUI: from the Start menu it shows "Open archive..."; Explorer's menu opens it on an archive. -->
    <Application Id="BRar" Executable="B-Rar-GUI.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="B-Rar" Description="Fast archive extractor" BackgroundColor="#021021"
                          Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- `B-Rar` on the command line, from any terminal. -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="B-Rar.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="B-Rar.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>

        <!-- "Open with > B-Rar": browse the archive. It doesn't take over the default app. -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="archive">
            <uap:DisplayName>Archive</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.zip</uap:FileType>
              <uap:FileType>.7z</uap:FileType>
              <uap:FileType>.rar</uap:FileType>
              <uap:FileType>.tar</uap:FileType>
              <uap:FileType>.gz</uap:FileType>
              <uap:FileType>.tgz</uap:FileType>
              <uap:FileType>.xz</uap:FileType>
              <uap:FileType>.txz</uap:FileType>
              <uap:FileType>.zst</uap:FileType>
              <uap:FileType>.tzst</uap:FileType>
              <uap:FileType>.bz2</uap:FileType>
              <uap:FileType>.tbz</uap:FileType>
              <uap:FileType>.tbz2</uap:FileType>
              <uap:FileType>.001</uap:FileType>
              <uap:FileType>.r00</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <!-- The Windows 11 short right-click menu, served by B-Rar-Shell.dll. -->
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <!-- Every file and folder: "Add to archive" is for anything, and B-Rar-Shell.dll
                 shows the extract commands only when the selection is all archives. -->
            <desktop5:ItemType Type="*"><desktop5:Verb Id="BRar" Clsid="91F265B3-8846-4B4F-9721-DA1F07BEC959" /></desktop5:ItemType>
            <desktop5:ItemType Type="Directory"><desktop5:Verb Id="BRar" Clsid="91F265B3-8846-4B4F-9721-DA1F07BEC959" /></desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>

        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="B-Rar context menu">
              <com:Class Id="91F265B3-8846-4B4F-9721-DA1F07BEC959" Path="B-Rar-Shell.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <!-- Extracting into folders only administrators can write to (Program Files): B-Rar
         restarts itself elevated, and Windows asks first. -->
    <rescap:Capability Name="allowElevation" />
  </Capabilities>
</Package>
